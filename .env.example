# Optional overrides. Copy to .env and edit.
# Season string in nba_api format
NBA_SEASON=2026-27
# Where parquet caches live
NBA_DATA_DIR=data
# Hours before cached raw data is considered stale and re-downloaded
NBA_CACHE_TTL_HOURS=12
# Optional HTTP proxy for stats.nba.com (cloud IPs are sometimes blocked)
NBA_API_PROXY=
# Never call the API; read only the committed parquet cache (use on Streamlit Cloud / CI)
NBA_OFFLINE=0
# Write rosters to data/my_rosters.json (set 0 on a public demo so visitors don't share one file)
NBA_ROSTER_SAVE=1
# Link from the Vercel site to the Streamlit app
STREAMLIT_APP_URL=
